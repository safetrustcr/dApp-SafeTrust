# Root-level environment example — shared/infrastructure variables.
# See apps/frontend/.env.example for the full frontend variable reference.

# TrustlessWork SDK
TRUSTLESSWORK_API_KEY=

# TrustlessWork escrow roles
NEXT_PUBLIC_PLATFORM_ADDRESS=
# USDC asset issuer on Stellar testnet — do not change for testnet use.
NEXT_PUBLIC_USDC_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR2JQTMZ35MIFUQ5IQSQ9CQBZ8JMXKDPE

# Hasura server-side access
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=myadminsecretkey
