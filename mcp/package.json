{
  "name": "@safetrust/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "echo \"no lint configured\"",
    "test": "echo \"no tests\"",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:escrow": "tsx --test tests/escrow-tools.test.ts",
    "test:boundary": "tsx --test tests/trust-boundary.test.ts",
    "docs:env": "node scripts/env-table.mjs --write",
    "docs:env:check": "node scripts/env-table.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.3",
    "@safetrust/api": "workspace:*"
  },
  "bin": {
    "safetrust-mcp": "dist/index.js"
  }
}
