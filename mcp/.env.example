# SafeTrust MCP server environment.
#
# Copy to mcp/.env (git-ignored) or put these values in your MCP client's `env`
# block (Claude Code `--env`, Claude Desktop `"env"`, or exported before the MCP
# Inspector); a value already in the environment wins over mcp/.env.
# docs/mcp/README.md renders the table below from this file: run
# `pnpm --filter @safetrust/mcp docs:env` after editing it.
#
# Every value must point at your LOCAL stack. Never put production URLs or
# production secrets here — see "Trust boundary" in docs/mcp/README.md.
#
# Format: each variable is preceded by `# @required`, `# @default` and
# `# @grants` comment lines. A variable that is unset by default is commented out.

# @required yes, for every Hasura tool
# @default none
# @grants Where every Hasura read goes (get-booking-context, get-escrow-status, get-pending-action, diagnose-escrow, get-apartment, list-apartments, query-*, hasura-query, and get-wallet-readiness's fallback). Must be the local Hasura from infra/backend/bin/start; non-local hosts are refused.
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql

# @required yes, for every Hasura tool
# @default none (local stack uses myadminsecretkey)
# @grants Hasura ADMIN access, narrowed to the select-only mcp_reader role on every request. Local stack only; rotate per "Incident response" if exposed. HASURA_GRAPHQL_ADMIN_SECRET is accepted as an alias.
HASURA_ADMIN_SECRET=myadminsecretkey

# @required yes, for apps/api tools
# @default none
# @grants Where deploy-escrow and fund-escrow send POST /api/escrow/* (unsigned XDR only), where get-wallet-readiness reads GET /api/escrow/readiness, and where check-stack-health pings. Must be the local apps/api; non-local hosts are refused.
SAFETRUST_API_URL=http://localhost:3002

# @required no
# @default false
# @grants Lets deploy-escrow and fund-escrow call apps/api as the Firebase test user. Even when true, they refuse unless apps/api reports stellarNetwork=TESTNET.
SAFETRUST_MCP_ALLOW_MUTATIONS=false

# @required yes, when SAFETRUST_MCP_ALLOW_MUTATIONS=true
# @default none
# @grants Firebase Web API key used to sign the local test user in.
SAFETRUST_MCP_FIREBASE_API_KEY=

# @required yes, when SAFETRUST_MCP_ALLOW_MUTATIONS=true
# @default none
# @grants Email of the Testnet-only Firebase test user the build tools act as.
SAFETRUST_MCP_TEST_EMAIL=mcp-guest@test.safetrust.dev

# @required yes, when SAFETRUST_MCP_ALLOW_MUTATIONS=true
# @default none
# @grants Password of that test user. Never a real person's account.
SAFETRUST_MCP_TEST_PASSWORD=

# @required no
# @default false
# @grants Registers hasura-query: arbitrary read-only GraphQL under the mcp_reader role.
SAFETRUST_MCP_ENABLE_RAW_HASURA=false

# @required no
# @default false
# @grants Allows HASURA_GRAPHQL_URL and SAFETRUST_API_URL to point at non-local hosts. Leave off.
# SAFETRUST_MCP_ALLOW_REMOTE=false

# @required no
# @default localhost, 127.0.0.1, host.docker.internal
# @grants Extra comma-separated hostnames treated as local.
# SAFETRUST_MCP_ALLOWED_HOSTS=

# @required no
# @default false
# @grants Prints full Stellar addresses instead of the GABC…WXYZ short form.
# SAFETRUST_MCP_SHOW_FULL_IDS=false

# @required no
# @default unset
# @grants Nothing: a public key shown by explain-escrow-roles. NEXT_PUBLIC_PLATFORM_ADDRESS is accepted as an alias.
# PLATFORM_STELLAR_ADDRESS=G...

# @required no
# @default Testnet USDC issuer
# @grants Nothing: the public USDC issuer used for trustline and balance checks; the same variable apps/api deploys with. NEXT_PUBLIC_USDC_ADDRESS is accepted as an alias.
# USDC_TRUSTLINE_ADDRESS=G...

# @required no
# @default https://horizon-testnet.stellar.org
# @grants Read-only Horizon lookups (accounts, transactions) for get-wallet-readiness and diagnose-escrow. Refused unless it is a Testnet or localhost Horizon.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# @required no
# @default auto-detected (nearest pnpm-workspace.yaml)
# @grants Which local files the safetrust://docs/* resources read. Point it only at a SafeTrust checkout.
# SAFETRUST_REPO_ROOT=/absolute/path/to/dApp-SafeTrust
