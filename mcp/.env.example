# SafeTrust MCP server environment.
#
# The server does not read a .env file. Put these values in your MCP client's
# `env` block (Claude Code `--env`, Claude Desktop `"env"`, or exported before the
# MCP Inspector). docs/mcp/README.md renders the table below from this file:
# run `pnpm --filter @safetrust/mcp docs:env` after editing it.
#
# Every value must point at your LOCAL stack. Never put production URLs or
# production secrets here — see "Trust boundary" in docs/mcp/README.md.
#
# Format: each variable is preceded by `# @required`, `# @default` and
# `# @grants` comment lines. A variable that is unset by default is commented out.

# @required no
# @default http://localhost:8080/v1/graphql
# @grants Where every Hasura read goes (get-booking-context, get-escrow-status, get-pending-action, diagnose-escrow, get-apartment, list-apartments, query-*, hasura-query, and get-wallet-readiness's fallback). Must be the local Hasura from infra/backend/bin/start.
# @grants Where every Hasura read goes (get-escrow-status, get-apartment, list-apartments, query-*, hasura-query). Must be the local Hasura from infra/backend/bin/start.
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql

# @required yes, for every Hasura tool
# @default none (local stack uses myadminsecretkey)
# @grants Hasura ADMIN access: every table, every row, row permissions bypassed. Treat all tool output as privileged. Local stack only; rotate per "Incident response" if exposed. HASURA_GRAPHQL_ADMIN_SECRET alone is not enough: the Hasura client reads HASURA_ADMIN_SECRET.
HASURA_ADMIN_SECRET=myadminsecretkey

# @required no
# @default http://localhost:3002
# @grants Where deploy-escrow and fund-escrow send POST /api/escrow/* (unsigned XDR only), where get-wallet-readiness reads GET /api/escrow/readiness, and where check-stack-health pings. Must be the local apps/api.
# @grants Where deploy-escrow and fund-escrow send POST /api/escrow/* (unsigned XDR only), and where check-stack-health pings. Must be the local apps/api.
SAFETRUST_API_URL=http://localhost:3002

# @required no
# @default unset
# @grants Nothing: a public key shown by explain-escrow-roles. NEXT_PUBLIC_PLATFORM_ADDRESS is accepted as an alias.
# PLATFORM_STELLAR_ADDRESS=G...

# @required no
# @default Testnet USDC issuer
# @grants Nothing: the public USDC issuer used for trustline and balance checks; the same variable apps/api deploys with. NEXT_PUBLIC_USDC_ADDRESS is accepted as an alias.
# USDC_TRUSTLINE_ADDRESS=G...

# @required no
# @default https://horizon-testnet.stellar.org
# @grants Read-only Horizon lookups (accounts, transactions) for get-wallet-readiness and diagnose-escrow. Refused unless it is a Testnet or localhost Horizon.
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# @grants Nothing: a public key shown by explain-escrow-roles.
# NEXT_PUBLIC_USDC_ADDRESS=G...

# @required no
# @default auto-detected (nearest pnpm-workspace.yaml)
# @grants Which local files the safetrust://docs/* resources read. Point it only at a SafeTrust checkout.
# SAFETRUST_REPO_ROOT=/absolute/path/to/dApp-SafeTrust
