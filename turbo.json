{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "STELLAR_NETWORK_PASSPHRASE"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^test:integration"
      ],
      "env": [
        "TRUSTLESS_WORK_API_KEY",
        "INTEGRATION_SENDER_ADDRESS",
        "INTEGRATION_RECEIVER_ADDRESS",
        "INTEGRATION_APARTMENT_ID",
        "HASURA_GRAPHQL_URL",
        "HASURA_ADMIN_SECRET",
        "API_URL"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [],
      "env": [
        "E2E_GUEST_SECRET",
        "E2E_HOST_SECRET",
        "E2E_PLATFORM_SECRET",
        "E2E_GUEST_EMAIL",
        "E2E_HOST_EMAIL",
        "E2E_ADMIN_EMAIL",
        "E2E_TEST_PASSWORD",
        "E2E_DEPOSIT_USDC",
        "E2E_TW_RATE_BUDGET",
        "E2E_PAYOUT_FEE_TOLERANCE",
        "TRUSTLESS_WORK_API_KEY",
        "TRUSTLESS_WORK_API_URL",
        "PLATFORM_STELLAR_ADDRESS",
        "USDC_TRUSTLINE_ADDRESS",
        "RECONCILIATION_SECRET",
        "HASURA_GRAPHQL_URL",
        "HASURA_ADMIN_SECRET",
        "STELLAR_HORIZON_URL",
        "STELLAR_NETWORK_PASSPHRASE",
        "NEXT_PUBLIC_FIREBASE_API_KEY",
        "FIREBASE_AUTH_EMULATOR_HOST",
        "PLAYWRIGHT_BASE_URL",
        "API_URL",
        "NEXT_PUBLIC_E2E_WALLET"
      ],
      "cache": false
    },
    "codegen": {
      "cache": false
    },
    "@safetrust/mcp#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}