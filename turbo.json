{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "env": [
        "TRUSTLESS_WORK_API_KEY",
        "INTEGRATION_SENDER_ADDRESS",
        "INTEGRATION_RECEIVER_ADDRESS",
        "INTEGRATION_APARTMENT_ID",
        "HASURA_GRAPHQL_URL",
        "HASURA_ADMIN_SECRET",
        "API_URL"
      ],
      "cache": false
    },
    "codegen": {
      "cache": false
    },
    "@safetrust/mcp#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
