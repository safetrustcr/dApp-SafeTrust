# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placeholder_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=placeholder.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Hasura GraphQL
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
# Server-side Hasura access, used by the middleware role lookup.
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=placeholder_admin_secret
# Hotel dashboard: use mock data until hotel_industry tables are tracked in Hasura.
NEXT_PUBLIC_USE_HOTEL_MOCKS=true
# Backend auth-sync service
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3002
# Stellar network passphrase: same variable name as apps/api (read by both).
# Full passphrase only, not "TESTNET". Testnet: "Test SDF Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Pollar embedded Stellar wallet (publishable key — safe to expose)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=placeholder_pollar_key
# E2E test mode
NEXT_PUBLIC_E2E_WALLET=false
# Development
NODE_ENV=development
# ── Testnet keypairs (provisioned by pnpm testnet:provision) ─────────────────
E2E_GUEST_SECRET=S...              # Stellar secret key for the guest test account
E2E_HOST_SECRET=S...               # Stellar secret key for the host test account
E2E_PLATFORM_SECRET=S...           # Stellar secret key for the platform/dispute-resolver
# ── Firebase test-project credentials ────────────────────────────────────────
E2E_GUEST_EMAIL=guest@safetrust-e2e.test
E2E_HOST_EMAIL=host@safetrust-e2e.test
E2E_HOST_PASSWORD=SafeTest2026!
# ── Seeded apartment ─────────────────────────────────────────────────────────
E2E_APARTMENT_ID=00000000-0000-0000-0000-000000000001
E2E_APARTMENT_NAME=E2E Test Apartment
# ── Service keys ─────────────────────────────────────────────────────────────
# RECONCILIATION_SECRET must match the Hasura container's value (Docker default: myreconciliationsecret).
# Trustless Work keys are read by apps/api only and are not set in this file.
E2E_RECONCILIATION_SECRET=myreconciliationsecret
# ── Server URLs (default to local stack) ─────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3001
API_URL=http://localhost:3002
# ── Enable the e2e wallet provider in Next.js ────────────────────────────────
# This MUST NOT be set in production or staging deployments.
# Set NEXT_PUBLIC_E2E_WALLET=true only for e2e runs (see the earlier flag above).
# Stellar network: the full passphrase, same variable name as apps/api.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
# Trustless Work is called only by apps/api. Never put TRUSTLESS_WORK_API_KEY
# or TRUSTLESS_WORK_API_URL in this file.
# ── Testnet E2E (see docs/testnet-booking.md) ───────────────────────────────
# The Playwright specs read these from the shell, apps/frontend/.env.e2e.local,
# <repo>/.env.testnet.local (written by `pnpm testnet:provision --generate`)
# or apps/api/.env. Never commit real secrets.
# Keypairs provisioned by pnpm testnet:provision
# Firebase users created by pnpm testnet:provision (password: E2E_TEST_PASSWORD)
E2E_ADMIN_EMAIL=admin@safetrust.local
E2E_TEST_PASSWORD=Password123!
# Set when apps/api verifies tokens against the Auth emulator instead of a real project.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Deposit each spec escrows, in testnet USDC (the suite books twice).
E2E_DEPOSIT_USDC=2
# TRUSTLESS_WORK_API_KEY, PLATFORM_STELLAR_ADDRESS, USDC_TRUSTLINE_ADDRESS,
# RECONCILIATION_SECRET and HASURA_ADMIN_SECRET are read by the specs from
# apps/api/.env or the shell. Never put the Trustless Work key in this file.
