# Copy this file to .env.local and fill in every value before running `pnpm run dev`.
# Variables prefixed NEXT_PUBLIC_ are bundled into the browser bundle — never put secrets there.
# Variables without that prefix are server-only (Next.js Server Actions / Route Handlers).

# ── Firebase ──────────────────────────────────────────────────────────────────
# From Firebase Console → Project Settings → General → Your apps → Web app
# https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Hasura GraphQL ────────────────────────────────────────────────────────────
# HTTP and WebSocket endpoints for Apollo Client (browser-side).
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_WS_URL=ws://localhost:8080/v1/graphql

# Used by Apollo Client on the browser to authenticate with Hasura.
# Must match HASURA_GRAPHQL_ADMIN_SECRET in infra/hasura/.env.
# Note: for production, replace admin-secret auth with JWT role claims.
NEXT_PUBLIC_HASURA_ADMIN_SECRET=myadminsecretkey

# Server-only admin secret for direct Hasura calls in Server Actions / Route Handlers.
# ⚠️  Never prefix this with NEXT_PUBLIC_ — it must never reach the browser.
# Must match HASURA_GRAPHQL_ADMIN_SECRET in infra/hasura/.env.
HASURA_ADMIN_SECRET=myadminsecretkey

# ── Backend auth-sync service ─────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002

# ── TrustlessWork API ─────────────────────────────────────────────────────────
# Required for escrow deploy, fund, milestone, and release flows.
# Missing TRUSTLESS_WORK_API_KEY or TRUSTLESS_WORK_API_URL causes trustlesswork.ts
# to throw at module load and crash the Next.js server.
#
# Get your testnet API key at: https://dapp.trustlesswork.com
#   Step 1: Connect your Freighter wallet.
#   Step 2: Fill in Settings → Profile (use case field is required).
#   Step 3: Settings → API Keys → Request API Key → select Testnet.
#   Copy the key immediately — it is shown only once.
#
# Full guide: https://docs.trustlesswork.com/trustless-work/introduction/developer-resources/request-api-key

# Server-side API key — used by Route Handlers and Server Actions.
TRUSTLESS_WORK_API_KEY=
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com

# Client-side API key — used by TrustlessWorkProvider (browser SDK).
# If not set the SDK will log a warning and all client requests will return 401.
NEXT_PUBLIC_TRUSTLESS_WORK_API_KEY=

# Set to "mainnet" to use the production Stellar network; leave unset for testnet.
NEXT_PUBLIC_TRUSTLESS_WORK_ENV=

# ── Stellar / Escrow Configuration ───────────────────────────────────────────
# SafeTrust's own Stellar wallet address.
# Acts as platformAddress, releaseSigner, and disputeResolver in TrustlessWork escrow roles.
NEXT_PUBLIC_PLATFORM_ADDRESS=

# USDC asset issuer on Stellar testnet — do not change this for testnet use.
NEXT_PUBLIC_USDC_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR2JQTMZ35MIFUQ5IQSQ9CQBZ8JMXKDPE
