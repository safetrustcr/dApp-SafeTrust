# Hasura GraphQL
# NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql

# Server-side Hasura access, used by the middleware role lookup.
# HASURA_GRAPHQL_URL overrides NEXT_PUBLIC_HASURA_GRAPHQL_URL when set; prefer it
# so the URL used with the admin secret is never bundled into client code.
# Without HASURA_ADMIN_SECRET the role query is rejected and every user is
# treated as a guest.
# HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
# HASURA_ADMIN_SECRET=your_admin_secret_here

# Hotel dashboard: use mock data until hotel_industry tables are tracked in Hasura.
# Set to false to hit GET_HOTEL_ROOMS / GET_ACTIVE_RESERVATIONS / GET_HOTEL_ESCROW_TRANSACTIONS.
# NEXT_PUBLIC_USE_HOTEL_MOCKS=true

# Backend auth-sync service 
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Development
# NODE_ENV=development
