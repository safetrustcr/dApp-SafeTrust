# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=placeholder_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=placeholder_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=placeholder.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:placeholder

# Hasura GraphQL
NEXT_PUBLIC_HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_ADMIN_SECRET=placeholder_admin_secret

# Server-side Hasura access, used by the middleware role lookup.
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=placeholder_admin_secret

# Hotel dashboard: use mock data until hotel_industry tables are tracked in Hasura.
NEXT_PUBLIC_USE_HOTEL_MOCKS=true

# Backend auth-sync service
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000

# TrustlessWork API
TRUSTLESS_WORK_API_URL=http://localhost:3000
TRUSTLESS_WORK_API_KEY=placeholder_tw_key

# Pollar embedded Stellar wallet (publishable key — safe to expose)
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=placeholder_pollar_key

# E2E test mode
NEXT_PUBLIC_E2E_WALLET=false

# Development
NODE_ENV=development
