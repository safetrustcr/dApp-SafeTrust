# E2E test environment variables — copy to .env.e2e.local and fill in secrets.
# These are used exclusively by the Playwright golden-path test suite.
# NEVER commit real values for these keys.

# ── Testnet keypairs (provisioned by pnpm testnet:provision) ─────────────────
E2E_GUEST_SECRET=S...              # Stellar secret key for the guest test account
E2E_HOST_SECRET=S...               # Stellar secret key for the host test account
E2E_PLATFORM_SECRET=S...           # Stellar secret key for the platform/dispute-resolver

# ── Firebase test-project credentials ────────────────────────────────────────
E2E_GUEST_EMAIL=guest@safetrust-e2e.test
E2E_HOST_EMAIL=host@safetrust-e2e.test
E2E_HOST_PASSWORD=SafeTest2026!

# ── Seeded apartment ─────────────────────────────────────────────────────────
E2E_APARTMENT_ID=00000000-0000-0000-0000-000000000001
E2E_APARTMENT_NAME=E2E Test Apartment

# ── Service keys ─────────────────────────────────────────────────────────────
TRUSTLESS_WORK_API_KEY=...
E2E_RECONCILIATION_SECRET=...

# ── Server URLs (default to local stack) ─────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3001
API_URL=http://localhost:3000

# ── Enable the e2e wallet provider in Next.js ────────────────────────────────
# This MUST NOT be set in production or staging deployments.
NEXT_PUBLIC_E2E_WALLET=true
