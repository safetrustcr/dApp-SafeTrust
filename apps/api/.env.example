# Environment variables for apps/api
# Copy to apps/api/.env and fill in values. Each variable appears once; the comment names the reader.

PORT=3002
NODE_ENV=development

# Hasura (read by apps/api)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# Hasura event webhook secret (optional for dev; read by apps/api)
HASURA_EVENT_SECRET=

# Shared secret for the reconciliation cron endpoint (read by apps/api).
# Must match the Hasura container's value (Docker default: myreconciliationsecret).
RECONCILIATION_SECRET=myreconciliationsecret

# TrustlessWork (read by apps/api)
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
# Testnet secret key for TrustlessWork escrow calls (read by apps/api)
TRUSTLESS_WORK_API_KEY=replace-with-testnet-secret-key

# Escrow config for rental bookings on testnet (read by apps/api).
# If either is missing, POST /api/escrow/deploy returns 503 ESCROW_NOT_CONFIGURED.
PLATFORM_STELLAR_ADDRESS=G...
USDC_TRUSTLINE_ADDRESS=G...

# Stellar network (read by apps/api)
# Must be the full passphrase, not a shorthand like TESTNET.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Firebase Admin SDK (read by apps/api)
# Get from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Web push delivery (read by apps/api; disabled by default)
PUSH_NOTIFICATIONS_ENABLED=false
APP_PUBLIC_URL=https://app.safetrust.example

# Pollar secret key (read by apps/api) — get from maintainer
POLLAR_SECRET_KEY=

# Integration tests only (read by apps/api test suite). Never commit real values.
INTEGRATION_SENDER_ADDRESS=G...   # testnet wallet — tenant role
INTEGRATION_RECEIVER_ADDRESS=G... # testnet wallet — host role
INTEGRATION_APARTMENT_ID=         # valid UUID from public.apartments
API_URL=http://localhost:3002
