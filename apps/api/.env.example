# Environment variables for apps/api

PORT=3002
NODE_ENV=development

# Hasura (read by apps/api)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# TrustlessWork (read by apps/api)
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=replace-with-testnet-secret-key

# Server-only Stellar addresses used to build a rental escrow on testnet (read by apps/api)
PLATFORM_STELLAR_ADDRESS=G...
USDC_TRUSTLINE_ADDRESS=G...

# Firebase Admin SDK (read by apps/api) — get from Firebase Console → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CLIENT_EMAIL=replace-with-firebase-client-email
FIREBASE_PRIVATE_KEY=replace-with-firebase-private-key

# Pollar (read by apps/api) — get from maintainer
POLLAR_SECRET_KEY=replace-with-pollar-secret-key

# Hasura event webhook secret (read by apps/api, optional for dev)
HASURA_EVENT_SECRET=replace-with-hasura-event-secret
