# Environment variables for apps/api

PORT=3002
NODE_ENV=development

# Hasura (read by apps/api)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# Hasura event webhook secret (optional for dev)
HASURA_EVENT_SECRET=
# Shared with Hasura's reconciliation cron trigger. Must equal RECONCILIATION_SECRET
# in infra/backend/.env; docker-compose falls back to "myreconciliationsecret" for
# Hasura when that one is unset, so set both explicitly.
RECONCILIATION_SECRET=replace-with-a-random-cron-secret

# Firebase Admin SDK — get from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# ── Stellar / escrow (see docs/architecture/testnet-readiness.md) ────────────
# The full network passphrase, not a label like "TESTNET". The frontend reads
# the same variable name.
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Trustless Work — a real testnet API key. Server-only: never in apps/frontend.
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=replace-with-testnet-secret-key

# Issuer of the USDC asset escrows use. Circle's testnet USDC issuer is below;
# confirm it against https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_TRUSTLINE_ADDRESS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Funded testnet account (Friendbot) with a USDC trustline; receives platform
# fees and acts as dispute resolver. Without this or USDC_TRUSTLINE_ADDRESS,
# deploy/readiness fail with ESCROW_NOT_CONFIGURED.
PLATFORM_STELLAR_ADDRESS=G...

# Pollar — get from maintainer
POLLAR_SECRET_KEY=replace-with-pollar-key

# Web push delivery (disabled by default)
PUSH_NOTIFICATIONS_ENABLED=false
APP_PUBLIC_URL=https://app.safetrust.example

# ── Integration tests only — never commit real values ────────────────────────
# Also need TRUSTLESS_WORK_API_KEY above.
INTEGRATION_SENDER_ADDRESS=G...   # testnet wallet — tenant role
INTEGRATION_RECEIVER_ADDRESS=G... # testnet wallet — host role
INTEGRATION_APARTMENT_ID=         # valid UUID from public.apartments
API_URL=http://localhost:3002
