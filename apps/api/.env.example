PORT=3002
NODE_ENV=development

# Hasura
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# TrustlessWork
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=

# Firebase Admin SDK — get from Firebase Console → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=#safetrust_id
FIREBASE_PRIVATE_KEY=#safetrust_key

# Pollar — get from maintainer
POLLAR_SECRET_KEY=

# Hasura event webhook secret (optional for dev)
HASURA_EVENT_SECRET=