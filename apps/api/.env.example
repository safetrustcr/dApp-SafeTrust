# Server
PORT=3002

# CORS - comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3001

# TrustlessWork
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=your_api_key_here

# Stellar
PLATFORM_STELLAR_ADDRESS=your_stellar_address_here
PLATFORM_FEE_PERCENT=1

# Hasura (server-side)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_GRAPHQL_WS_URL=ws://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=your_hasura_admin_secret

# Pollar (server-side only, never expose to the browser). Copy the value into .env
POLLAR_SECRET_KEY=
