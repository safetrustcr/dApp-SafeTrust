# Environment variables for apps/api

PORT=3002
NODE_ENV=development

# Hasura (read by apps/api)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=myadminsecretkey

# TrustlessWork (read by apps/api)
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=replace-with-testnet-secret-key

# Server-only Stellar addresses used to build a rental escrow on testnet (read by apps/api)
PLATFORM_STELLAR_ADDRESS=G...
USDC_TRUSTLINE_ADDRESS=G...

# Firebase Admin SDK — get from Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=replace-with-project-id
FIREBASE_CLIENT_EMAIL=replace-with-service-account-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----\n"

# Pollar — get from maintainer
POLLAR_SECRET_KEY=

# Hasura event webhook secret (optional for dev)
HASURA_EVENT_SECRET=
RECONCILIATION_SECRET=replace-with-a-random-cron-secret
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# SEP-10 wallet authentication (server-side only; never expose or commit the seed)
SEP10_SIGNING_SEED=
SEP10_HOME_DOMAIN=
SEP10_WEB_AUTH_DOMAIN=
STELLAR_NETWORK=TESTNET

# apps/api service (replaces webhook)
TRUSTLESS_WORK_API_KEY=replace-with-testnet-secret-key
POLLAR_SECRET_KEY=replace-with-pollar-key
