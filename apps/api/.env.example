# Server
PORT=3002

# CORS - comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3001

# TrustlessWork
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
TRUSTLESS_WORK_API_KEY=your_api_key_here

# Stellar
PLATFORM_STELLAR_ADDRESS=your_stellar_address_here
PLATFORM_FEE_PERCENT=1

# Hasura GraphQL - required for role assignment (promote-to-host)
HASURA_GRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=your_admin_secret_here
