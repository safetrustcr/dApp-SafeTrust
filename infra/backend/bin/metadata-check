#!/usr/bin/env bash
set -eo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# metadata-check
# Verifies Hasura metadata consistency and fails CI/local execution if
# any metadata object (table, relationship, permission, trigger) is inconsistent.
# ─────────────────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INFRA_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

HASURA_ENDPOINT="${HASURA_ENDPOINT:-http://localhost:8080}"
HASURA_ADMIN_SECRET="${HASURA_GRAPHQL_ADMIN_SECRET:-${HASURA_ADMIN_SECRET:-myadminsecretkey}}"

echo "🔍 Checking Hasura metadata consistency..."
echo "   Endpoint: $HASURA_ENDPOINT"

rc=0
out="$(hasura metadata ic list --project "$INFRA_DIR" --endpoint "$HASURA_ENDPOINT" --admin-secret "$HASURA_ADMIN_SECRET" --skip-update-check 2>&1)" || rc=$?

if [ "$rc" -ne 0 ]; then
  echo "$out"
  echo "❌ hasura metadata ic list failed (exit $rc)" >&2
  exit "$rc"
fi

if ! grep -q "metadata is consistent" <<<"$out"; then
  echo "$out"
  echo "❌ Hasura metadata is inconsistent" >&2
  exit 1
fi

echo "$out"
echo "✅ Hasura metadata is consistent"
