# PostgreSQL
POSTGRES_USER=postgresuser
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=postgresdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PG_DATABASE_URL=postgres://postgres:replace-with-a-local-password@localhost:5433/postgres

# Hasura
HASURA_GRAPHQL_ADMIN_SECRET=replace-with-a-local-admin-secret
HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"replace-with-a-development-key-at-least-32-characters"}
WEBHOOK_URL=http://host.docker.internal:3002
HASURA_EVENT_SECRET=replace-with-a-local-event-secret
WEBHOOK_ADMIN_SECRET=replace-with-a-local-webhook-admin-secret
RECONCILIATION_SECRET=replace-with-a-random-cron-secret

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-your-private-key\\n-----END PRIVATE KEY-----\\n"

# SEP-10 wallet authentication (server-side only; never expose or commit the seed)
SEP10_SIGNING_SEED=
SEP10_HOME_DOMAIN=
SEP10_WEB_AUTH_DOMAIN=
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
FRONTEND_URL=http://localhost:3001

# Provision the SafeTrust demo guest, host, and controller users after SQL seeds.
FIREBASE_SEED_USERS=true
FIREBASE_SEED_PASSWORD=replace-with-a-development-password
